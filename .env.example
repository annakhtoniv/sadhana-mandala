# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Organisation Configuration
# Used in v1 to identify the active organisation
VITE_ORG_SLUG=sadhana-mandala

# Daily practice reminders (Phase 18): the public half of the push key pair.
# The private half is only a Supabase Edge Function secret (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=

# Supabase Service Role Key (used ONLY in local node admin/seed scripts, NEVER exposed in the frontend app)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
